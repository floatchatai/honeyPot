#!/usr/bin/env python3
"""Incrementally scan the FreeSWITCH log for SIP registration/auth probes and keep a scanner IP table
for the gate (SCANNER_IP signal). Runs from cron every 10 minutes; remembers its log offset."""
import os, re, json, time
LOG = "/var/log/freeswitch/freeswitch.log"
OUT = "/opt/voip/companies/scanner_ips.tsv"
STATE = "/opt/voip/companies/scanner_state.json"
PAT = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\.\d+ .*?(?:Can't find user \[[^\]]*\] from ([0-9.]+)|SIP auth (?:failure|challenge) .*? from ip ([0-9.]+)|Rejecting register from ([0-9.]+))", re.M)
state = {"offset": 0, "inode": 0, "ips": {}}
try:
    state.update(json.load(open(STATE)))
except Exception:
    pass
try:
    st = os.stat(LOG)
except OSError:
    raise SystemExit(0)
if st.st_ino != state.get("inode") or st.st_size < state.get("offset", 0):
    state["offset"], state["inode"] = 0, st.st_ino
ips = state.get("ips") or {}
with open(LOG, "r", encoding="utf-8", errors="replace") as f:
    f.seek(state["offset"])
    while True:
        chunk = f.read(8 * 1024 * 1024)
        if not chunk:
            break
        for m in PAT.finditer(chunk):
            ip = m.group(2) or m.group(3) or m.group(4)
            if not ip: continue
            e = ips.setdefault(ip, {"count": 0, "last": "", "first": m.group(1)})
            e["count"] += 1
            if m.group(1) > e["last"]: e["last"] = m.group(1)
    state["offset"] = f.tell()
# keep 90 days of scanners, most active first
cutoff = time.strftime("%Y-%m-%d", time.gmtime(time.time() - 90 * 86400))
ips = {ip: e for ip, e in ips.items() if e["last"][:10] >= cutoff}
state["ips"] = ips
os.makedirs(os.path.dirname(OUT), exist_ok=True)
tmp = OUT + ".tmp"
with open(tmp, "w") as f:
    f.write("# ip<TAB>probe_count<TAB>last_seen<TAB>first_seen  (generated by update_voip_scanner_ips)\n")
    for ip, e in sorted(ips.items(), key=lambda kv: -kv[1]["count"]):
        f.write("%s\t%d\t%s\t%s\n" % (ip, e["count"], e["last"], e["first"]))
os.replace(tmp, OUT)
json.dump(state, open(STATE + ".tmp", "w")); os.replace(STATE + ".tmp", STATE)
print("scanner ips: %d" % len(ips))
